# 统一编辑器行为：缩进、换行、编码（各工程自己的 .prettierrc / eslint 仍然优先）
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.py]
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2
