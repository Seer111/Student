# 根目录环境变量模板（docker compose 用）
# 用法：复制本文件为 .env，填入真实值后执行 docker compose up -d --build
# 说明：.env 已被 .gitignore 忽略，不要提交；这份模板可以提交
#
# 注意：docker compose 只读**根目录**的 .env，不会读 feynman-platform-backend/.env

# ===== 必填 =====
# MongoDB 连接串（Atlas：Connect → Drivers 里获取；容器内同样需要 Atlas 放行宿主出口 IP）
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/feynman-db?retryWrites=true&w=majority

# JWT 签名密钥（随便一串足够长的随机字符即可）
JWT_SECRET=your_jwt_secret_here

# ===== AI 服务（07~11 课）=====
# DeepSeek（08 课主用 LLM）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 百度千帆（08 课备用 LLM + 10 课 Embedding 向量化）
QIANFAN_API_KEY=your_qianfan_api_key_here
QIANFAN_MODEL=ernie-4.5-turbo-128k

# OpenAI（可选，第三个 LLM）
OPENAI_API_KEY=your_openai_api_key_here

# ===== 语音转写（07 课 / 7.5 课进阶）=====
# 取值只需 base / small / medium，决定 whisper 镜像里烤进去的模型大小（越大越准也越大）
WHISPER_MODEL=base
