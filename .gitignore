# 依赖与构建产物（可由 npm install / npm run build 重建）
node_modules/
dist/

# 环境变量（包含数据库密码、JWT 密钥等敏感信息，禁止提交）
.env
.env.local
.env.*.local

# 日志
logs
*.log

# Python 编译缓存
__pycache__/
*.pyc

# 编辑器与系统文件
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# 桌面端打包产物（体积大，由 electron-builder 重新生成）
release/

# 构建缓存与临时目录
.vite/
dev-dist/
*.tmp
*.tmpdir/
Thumbs.db

# 课件工程的中间产物（源文件 svg_output/ notes/ 保留，导出物与备份不入库）
docs/课程PPT/*/backup/
docs/课程PPT/*/exports/

# agent 运行时留下的临时抓取物
_dsh*
