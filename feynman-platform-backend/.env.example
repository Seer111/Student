# 环境变量配置模板：复制本文件为 .env 后填入真实值
# 注意：.env 文件包含敏感信息，已被 .gitignore 忽略，请勿提交

# 服务端口
PORT=3000

# 运行环境：development / production
NODE_ENV=development

# MongoDB Atlas 连接字符串（在 Atlas -> Connect -> Drivers 中获取）
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/feynman-db?retryWrites=true&w=majority

# JWT 签名密钥
JWT_SECRET=your_jwt_secret_here
