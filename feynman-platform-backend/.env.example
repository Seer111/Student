# 环境变量配置模板：复制本文件为 .env 后填入真实值
# 注意：.env 文件包含敏感信息，已被 .gitignore 忽略，请勿提交

# 服务端口
PORT=3000

# 运行环境：development / production
NODE_ENV=development

# MongoDB Atlas 连接字符串（在 Atlas -> Connect -> Drivers 中获取）
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/feynman-db?retryWrites=true&w=majority

# JWT 签名密钥
JWT_SECRET=your_jwt_secret_here

# ===== AI 服务配置（07~11课）=====

# 百度智能云语音识别（07课）：复用下方 QIANFAN_API_KEY（bce-v3 Bearer 鉴权）即可，
# 需保证该应用已在语音技术控制台开通「短语音识别」能力
# BAIDU_API_KEY=your_baidu_api_key_here
# BAIDU_SECRET_KEY=your_baidu_secret_key_here

# DeepSeek（08课主用 LLM）：https://platform.deepseek.com 控制台创建 API Key
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 百度千帆（08课备用 LLM + 10课 Embedding 向量化）：https://console.bce.baidu.com/qianfan
# 只需 API Key：千帆 v2 接口用 bce-v3 Bearer 鉴权（旧的 SECRET_KEY/oauth 换取 token 已不再使用）
QIANFAN_API_KEY=your_qianfan_api_key_here
# 千帆对话模型名（可选，默认 ernie-4.5-turbo-128k，官方推荐的 ernie-3.5-8k 替代模型；
# 想省成本可用 ernie-4.5-turbo-32k；注意 ernie-3.5-8k / ernie-speed 等旧模型已下线）
QIANFAN_MODEL=ernie-4.5-turbo-128k

# OpenAI（可选第三个 LLM 服务）
OPENAI_API_KEY=your_openai_api_key_here

# 本地 Whisper 服务地址（7.5课进阶，可选）
WHISPER_API_URL=http://localhost:5001/transcribe
